#!/usr/bin/env bash
# iBoard pre-commit: fast static privacy audit only. The simulator tests run in the pre-push hook
# (hosted CI has no iOS 27 simulator). Skip once: IBOARD_SKIP_HOOK=1 git commit ... (or --no-verify).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [ "${IBOARD_SKIP_HOOK:-0}" = 1 ]; then echo "pre-commit: skipped (IBOARD_SKIP_HOOK=1)"; exit 0; fi
echo "pre-commit: privacy audit"
scripts/audit-privacy.sh
